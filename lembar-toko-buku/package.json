{
  "name": "lembar-toko-buku",
  "version": "3.0.0",
  "description": "Toko buku CRUD: Express + Prisma + Neon Postgres",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "db:push": "prisma db push",
    "db:seed": "node prisma/seed.js",
    "db:studio": "prisma studio",
    "dev": "concurrently -n backend,frontend -c blue,green \"npm start\" \"npm --prefix client run dev\"",
    "setup": "npm install && npm --prefix client install",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
    "prisma": "^6.0.0"
  }
}
